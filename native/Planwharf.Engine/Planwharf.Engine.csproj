<Project Sdk="Microsoft.NET.Sdk">
  <!-- Planwharf's engine in C#, ported module by module from engine/*.cjs (see native/porting/README.md).
       Base library only: no NuGet package. Native AOT compatible from the first line: the analyzers
       turn anything that needs reflection into a build error. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Planwharf.Engine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
