@@ -0,0 +1,81 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const fsp = fs.promises;
+const os = require('node:os');
+const path = require('node:path');
+const { createScheduler } = require('./scheduler.cjs');
+
+async function checkpoint() {
+  const dir = await fsp.mkdtemp(path.join(os.tmpdir(), 'scheduler-'));
+  return { dir, file: path.join(dir, 'nested', 'checkpoint.json') };
+}
+
+test('runs dependency graph in order and respects concurrency', async () => {
+  const { dir, file } = await checkpoint();
+  const events = [], active = { value: 0, max: 0 };
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async ({ id }) => {
+    active.value++; active.max = Math.max(active.max, active.value); events.push(`start:${id}`);
+    await new Promise(resolve => setTimeout(resolve, id === 'a' ? 15 : 2));
+    active.value--; events.push(`end:${id}`); return id.toUpperCase();
+  }});
+  await scheduler.enqueue([{ id: 'a' }, { id: 'b' }, { id: 'c', dependsOn: ['a', 'b'] }]);
+  const result = await scheduler.run();
+  assert.equal(active.max, 2);
+  assert.deepEqual(result.jobs.map(j => [j.id, j.status, j.attempt]), [['a','completed',1],['b','completed',1],['c','completed',1]]);
+  assert.ok(events.indexOf('start:c') > events.indexOf('end:a') && events.indexOf('start:c') > events.indexOf('end:b'));
+  await fsp.rm(dir, { recursive: true, force: true });
+});
+
+test('rejects invalid batches atomically', async () => {
+  const { dir, file } = await checkpoint();
+  const scheduler = createScheduler({ file, execute: async () => 1 });
+  await assert.rejects(scheduler.enqueue([{ id: 'ok' }, { id: 'bad!', dependsOn: ['missing'] }]));
+  assert.deepEqual(scheduler.snapshot(), { version: 1, jobs: [] });
+  await assert.rejects(scheduler.enqueue([{ id: 'a', dependsOn: ['b'] }, { id: 'b', dependsOn: ['a'] }]));
+  assert.equal(fs.existsSync(file), false);
+  await fsp.rm(dir, { recursive: true, force: true });
+});
+
+test('fails and transitively blocks descendants while continuing independent work', async () => {
+  const { dir, file } = await checkpoint();
+  const scheduler = createScheduler({ file, execute: async ({ id }) => { if (id === 'a') throw new Error('boom'); return id; } });
+  await scheduler.enqueue([{ id: 'a' }, { id: 'b', dependsOn: ['a'] }, { id: 'c', dependsOn: ['b'] }, { id: 'd' }]);
+  const result = await scheduler.run();
+  assert.deepEqual(result.jobs.map(j => [j.id, j.status]), [['a','failed'],['b','blocked'],['c','blocked'],['d','completed']]);
+  assert.equal(result.jobs[0].error, 'boom');
+  await fsp.rm(dir, { recursive: true, force: true });
+});
+
+test('concurrent runs join and completed jobs are not replayed', async () => {
+  const { dir, file } = await checkpoint(); let calls = 0;
+  const scheduler = createScheduler({ file, execute: async () => { calls++; await new Promise(r => setTimeout(r, 10)); return 7; } });
+  await scheduler.enqueue([{ id: 'one' }]);
+  const [a, b] = await Promise.all([scheduler.run(), scheduler.run()]);
+  assert.equal(calls, 1); assert.deepEqual(a, b);
+  await scheduler.run(); assert.equal(calls, 1);
+  await fsp.rm(dir, { recursive: true, force: true });
+});
+
+test('recovers a running checkpoint as pending and increments attempt', async () => {
+  const { dir, file } = await checkpoint();
+  await fsp.mkdir(path.dirname(file), { recursive: true });
+  await fsp.writeFile(file, JSON.stringify({ version: 1, jobs: [{ id:'job', dependsOn:[], payload:null, status:'running', attempt:1 }] }));
+  let seen;
+  const scheduler = createScheduler({ file, execute: async args => { seen = args; return 'ok'; } });
+  assert.equal(scheduler.snapshot().jobs[0].status, 'pending');
+  await scheduler.run(); assert.deepEqual(seen, { id:'job', payload:null, attempt:2 });
+  await fsp.rm(dir, { recursive: true, force: true });
+});
+
+test('reloads completed results and rejects corrupt checkpoints', async () => {
+  const { dir, file } = await checkpoint();
+  const first = createScheduler({ file, execute: async () => ({ value: 3 }) });
+  await first.enqueue([{ id:'done', payload:{ x:1 } }]); await first.run();
+  let called = false;
+  const second = createScheduler({ file, execute: async () => { called = true; } });
+  assert.deepEqual(second.snapshot().jobs[0].result, { value:3 }); await second.run(); assert.equal(called, false);
+  await fsp.writeFile(file, '{bad'); assert.throws(() => createScheduler({ file, execute: async () => {} }), /corrupt checkpoint/);
+  await fsp.rm(dir, { recursive: true, force: true });
+});

