'use strict';
const fs = require('node:fs');
const fsp = fs.promises;
const path = require('node:path');
const ID = /^[a-z][a-z0-9-]{0,31}$/;
const STATUSES = new Set(['pending', 'running', 'completed', 'failed', 'blocked']);
const JOB_KEYS = new Set(['id', 'dependsOn', 'payload']);
const copy = value => JSON.parse(JSON.stringify(value));
const errorText = e => e instanceof Error ? (e.message || String(e)) : String(e);

function createScheduler(options) {
  if (!options || typeof options !== 'object') throw new TypeError('options are required');
  const { file, concurrency = 1, execute, onStage } = options;
  if (typeof file !== 'string' || !file) throw new TypeError('file must be a non-empty string');
  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) throw new TypeError('concurrency must be an integer from 1 to 8');
  if (typeof execute !== 'function') throw new TypeError('execute must be a function');
  if (onStage !== undefined && typeof onStage !== 'function') throw new TypeError('onStage must be a function');
  const jobs = new Map(); let writeChain = Promise.resolve(); let drain = null; let tempCounter = 0;
  function validateGraph(map, corrupt = false) {
    const visiting = new Set(), visited = new Set();
    const walk = id => { if (visiting.has(id)) throw new Error(corrupt ? 'corrupt checkpoint' : 'dependency cycle'); if (visited.has(id)) return; visiting.add(id); for (const d of map.get(id).dependsOn) walk(d); visiting.delete(id); visited.add(id); };
    for (const id of map.keys()) walk(id);
  }
  if (fs.existsSync(file)) {
    let raw; try { raw = JSON.parse(fs.readFileSync(file, 'utf8')); } catch { throw new Error('corrupt checkpoint'); }
    if (!raw || raw.version !== 1 || !Array.isArray(raw.jobs)) throw new Error('corrupt checkpoint');
    const ids = new Set(); const loaded = new Map();
    for (const j of raw.jobs) {
      if (!j || typeof j !== 'object' || !ID.test(j.id) || ids.has(j.id) || !Array.isArray(j.dependsOn) || j.dependsOn.some(d => typeof d !== 'string' || !ID.test(d)) || new Set(j.dependsOn).size !== j.dependsOn.length || j.dependsOn.includes(j.id) || !STATUSES.has(j.status) || !Number.isInteger(j.attempt) || j.attempt < 0) throw new Error('corrupt checkpoint');
      if (j.status === 'completed' && !Object.prototype.hasOwnProperty.call(j, 'result')) throw new Error('corrupt checkpoint');
      if (j.status === 'failed' && typeof j.error !== 'string') throw new Error('corrupt checkpoint');
      ids.add(j.id); loaded.set(j.id, { ...j, dependsOn: [...j.dependsOn], status: j.status === 'running' ? 'pending' : j.status });
    }
    for (const j of loaded.values()) for (const d of j.dependsOn) if (!loaded.has(d)) throw new Error('corrupt checkpoint');
    try { validateGraph(loaded, true); } catch { throw new Error('corrupt checkpoint'); }
    for (const [id, j] of loaded) jobs.set(id, j);
  }
  function stateObject() { return { version: 1, jobs: [...jobs.values()].sort((a,b) => a.id.localeCompare(b.id)).map(j => { const x = { id:j.id, dependsOn:[...j.dependsOn], payload:j.payload, status:j.status, attempt:j.attempt }; if (j.status === 'completed') x.result=j.result; if (j.status === 'failed' || j.error !== undefined) x.error=j.error; return x; }) }; }
  async function persist() { const data = JSON.stringify(stateObject()); await fsp.mkdir(path.dirname(path.resolve(file)), { recursive:true }); const tmp = `${file}.tmp-${process.pid}-${++tempCounter}`; try { await fsp.writeFile(tmp, data, 'utf8'); await fsp.rename(tmp, file); } catch (e) { try { await fsp.unlink(tmp); } catch {} throw e; } }
  function commit(fn) { const result = writeChain.then(async () => { const value = await fn(); await persist(); return value; }); writeChain = result.catch(() => {}); return result; }
  function validateBatch(batch) {
    if (!Array.isArray(batch)) throw new TypeError('jobs must be an array'); const incoming = new Map();
    for (const item of batch) {
      if (!item || typeof item !== 'object' || Array.isArray(item) || Object.keys(item).some(k => !JOB_KEYS.has(k))) throw new TypeError('invalid job');
      if (typeof item.id !== 'string' || !ID.test(item.id) || incoming.has(item.id) || jobs.has(item.id)) throw new Error('duplicate or invalid id');
      const deps = item.dependsOn === undefined ? [] : item.dependsOn;
      if (!Array.isArray(deps) || deps.some(d => typeof d !== 'string' || !ID.test(d)) || new Set(deps).size !== deps.length || deps.includes(item.id)) throw new Error('invalid dependencies');
