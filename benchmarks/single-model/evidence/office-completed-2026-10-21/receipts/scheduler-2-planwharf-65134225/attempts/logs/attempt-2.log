--- /dev/null
+++ b/test.cjs
@@ -0,0 +1,42 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { createScheduler } = require('./scheduler.cjs');
+
+async function tempFile() { const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'scheduler-')); return path.join(dir, 'state.json'); }
+
+test('runs dependencies in order with bounded concurrency and persists results', async () => {
+  const file = await tempFile(); let active = 0; let peak = 0; const calls = [];
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async ({ id, attempt }) => { calls.push(`${id}:${attempt}`); active++; peak = Math.max(peak, active); await new Promise(r => setTimeout(r, 5)); active--; return id.toUpperCase(); } });
+  await scheduler.enqueue([{ id: 'b', dependsOn: ['a'] }, { id: 'a' }, { id: 'c' }]);
+  const result = await scheduler.run();
+  assert.equal(peak, 2); assert.deepEqual(calls, ['a:1', 'c:1', 'b:1']);
+  assert.deepEqual(result.jobs.map(j => [j.id, j.status, j.attempt]), [['a', 'completed', 1], ['b', 'completed', 1], ['c', 'completed', 1]]);
+  assert.equal(JSON.parse(await fs.readFile(file, 'utf8')).jobs[0].result, 'A');
+  assert.deepEqual(await scheduler.run(), result);
+});
+
+test('rejects invalid batches atomically and blocks descendants after failure', async () => {
+  const file = await tempFile(); const scheduler = createScheduler({ file, execute: async ({ id }) => { if (id === 'a') throw new Error('nope'); return 1; } });
+  await assert.rejects(scheduler.enqueue([{ id: 'ok' }, { id: 'bad', dependsOn: ['missing'] }]));
+  assert.deepEqual(scheduler.snapshot().jobs, []);
+  await scheduler.enqueue([{ id: 'a' }, { id: 'b', dependsOn: ['a'] }, { id: 'c', dependsOn: ['b'] }]); await scheduler.run();
+  assert.deepEqual(scheduler.snapshot().jobs.map(j => [j.id, j.status]), [['a', 'failed'], ['b', 'blocked'], ['c', 'blocked']]);
+});
+
+test('recovers a running checkpoint as a new attempt', async () => {
+  const file = await tempFile(); await fs.writeFile(file, JSON.stringify({ version: 1, jobs: [{ id: 'a', dependsOn: [], payload: null, status: 'running', attempt: 1 }] }));
+  const attempts = []; const scheduler = createScheduler({ file, execute: async ({ attempt }) => { attempts.push(attempt); return 'done'; } });
+  assert.equal(scheduler.snapshot().jobs[0].status, 'pending'); await scheduler.run(); assert.deepEqual(attempts, [2]);
+  const second = createScheduler({ file, execute: async () => { throw new Error('must not run'); } }); await second.run(); assert.equal(second.snapshot().jobs[0].attempt, 2);
+});
+
+test('validates factory options and corrupt checkpoints', async () => {
+  const file = await tempFile();
+  assert.throws(() => createScheduler({ file, concurrency: 0, execute() {} }));
+  assert.throws(() => createScheduler({ file, concurrency: 9, execute() {} }));
+  assert.throws(() => createScheduler({ file, execute: null }));
+  await fs.writeFile(file, '{broken'); assert.throws(() => createScheduler({ file, execute() {} }), /corrupt checkpoint/);
+});

