'use strict';
const fs = require('fs');
const path = require('path');
const ID = /^[a-z][a-z0-9-]{0,31}$/;
const STATUSES = new Set(['pending','running','completed','failed','blocked']);

function createScheduler(options) {
  if (!options || typeof options !== 'object') throw new TypeError('options are required');
  const { file, concurrency = 1, execute, onStage } = options;
  if (typeof file !== 'string' || !file) throw new TypeError('file must be a non-empty string');
  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) throw new TypeError('concurrency must be an integer from 1 to 8');
  if (typeof execute !== 'function') throw new TypeError('execute must be a function');
  if (onStage !== undefined && typeof onStage !== 'function') throw new TypeError('onStage must be a function');
  const jobs = new Map(); let draining = null; let writeTail = Promise.resolve();
  if (fs.existsSync(file)) {
    let data; try { data = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { throw new Error(`corrupt checkpoint: ${e.message}`); }
    if (!data || data.version !== 1 || !Array.isArray(data.jobs)) throw new Error('corrupt checkpoint');
    for (const j of data.jobs) {
      if (!j || typeof j.id !== 'string' || !ID.test(j.id) || jobs.has(j.id) || !Array.isArray(j.dependsOn) || j.dependsOn.some(d => typeof d !== 'string' || !ID.test(d)) || !STATUSES.has(j.status) || !Number.isInteger(j.attempt) || j.attempt < 0) throw new Error('corrupt checkpoint');
      jobs.set(j.id, {id:j.id, dependsOn:[...j.dependsOn], payload:j.payload === undefined ? null : j.payload, status:j.status === 'running' ? 'pending' : j.status, attempt:j.attempt, ...(Object.hasOwn(j,'result') ? {result:j.result} : {}), ...(Object.hasOwn(j,'error') ? {error:String(j.error)} : {})});
    }
    for (const j of jobs.values()) for (const d of j.dependsOn) if (!jobs.has(d)) throw new Error('corrupt checkpoint');
  }
  const json = value => { try { return JSON.stringify(value); } catch { throw new TypeError('values must be JSON-serializable'); } };
  function text() { return json({version:1,jobs:[...jobs.values()].sort((a,b)=>a.id.localeCompare(b.id)).map(j=>{const o={id:j.id,dependsOn:[...j.dependsOn],payload:j.payload,status:j.status,attempt:j.attempt}; if(Object.hasOwn(j,'result'))o.result=j.result; if(Object.hasOwn(j,'error'))o.error=j.error; return o;})}); }
  async function persist() { const body=text(); writeTail=writeTail.then(async()=>{await fs.promises.mkdir(path.dirname(path.resolve(file)),{recursive:true}); const tmp=`${file}.tmp-${process.pid}-${Date.now()}-${Math.random().toString(36).slice(2)}`; try {await fs.promises.writeFile(tmp,body); await fs.promises.rename(tmp,file);} catch(e){try{await fs.promises.unlink(tmp);}catch{} throw e;}}); return writeTail; }
  function snapshot() { return JSON.parse(text()); }
  async function enqueue(batch) {
    if (!Array.isArray(batch)) throw new TypeError('jobs must be an array');
    const incoming=new Map();
    for(const raw of batch){ if(!raw||typeof raw!=='object'||Array.isArray(raw)||Object.keys(raw).some(k=>!['id','dependsOn','payload'].includes(k)))throw new TypeError('invalid or unknown job fields'); if(typeof raw.id!=='string'||!ID.test(raw.id)||incoming.has(raw.id)||jobs.has(raw.id))throw new Error('invalid or duplicate id'); const deps=raw.dependsOn===undefined?[]:raw.dependsOn; if(!Array.isArray(deps)||new Set(deps).size!==deps.length||deps.some(d=>typeof d!=='string'||!ID.test(d)||d===raw.id))throw new Error('invalid dependencies'); const payload=raw.payload===undefined?null:raw.payload; json(payload); incoming.set(raw.id,{id:raw.id,dependsOn:[...deps],payload,status:'pending',attempt:0}); }
    const all=new Map([...jobs,...incoming]); for(const j of incoming.values())for(const d of j.dependsOn)if(!all.has(d))throw new Error(`unknown dependency: ${d}`); const visiting=new Set(),visited=new Set(); function visit(id){if(visiting.has(id))throw new Error('dependency cycle');if(visited.has(id))return;visiting.add(id);for(const d of all.get(id).dependsOn)visit(d);visiting.delete(id);visited.add(id);} for(const id of incoming.keys())visit(id);
    const old=new Map(jobs); for(const [id,j] of incoming)jobs.set(id,j); try{await persist();}catch(e){jobs.clear();for(const [id,j] of old)jobs.set(id,j);throw e;}
  }
  const ready=j=>j.status==='pending'&&j.dependsOn.every(d=>jobs.get(d).status==='completed');
  async function blockDescendants(id){const q=[id];while(q.length){const parent=q.shift();for(const j of jobs.values())if(j.status==='pending'&&j.dependsOn.includes(parent)){j.status='blocked';await persist();q.push(j.id);}}}
