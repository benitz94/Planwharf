+  const file = await tempFile(); let active = 0; let peak = 0; const calls = [];
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async ({ id, attempt }) => { calls.push(`${id}:${attempt}`); active++; peak = Math.max(peak, active); await new Promise(r => setTimeout(r, 5)); active--; return id.toUpperCase(); } });
