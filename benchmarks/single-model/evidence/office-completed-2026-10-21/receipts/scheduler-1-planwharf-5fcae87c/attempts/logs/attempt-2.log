'use strict';

const fs = require('node:fs');
const fsp = fs.promises;
const path = require('node:path');
const ID = /^[a-z][a-z0-9-]{0,31}$/;
const STATUSES = new Set(['pending', 'running', 'completed', 'failed', 'blocked']);
let tempCounter = 0;
const clone = value => JSON.parse(JSON.stringify(value));

function createScheduler(options) {
  if (!options || typeof options !== 'object') throw new TypeError('options are required');
  const { file, concurrency = 1, execute, onStage } = options;
  if (typeof file !== 'string' || !file) throw new TypeError('file must be a non-empty string');
  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) throw new TypeError('concurrency must be an integer from 1 to 8');
  if (typeof execute !== 'function') throw new TypeError('execute must be a function');
  if (onStage !== undefined && typeof onStage !== 'function') throw new TypeError('onStage must be a function');
  const jobs = new Map();
  const directory = path.dirname(path.resolve(file));
  let drainPromise = null;

  function checkpoint() {
    return { version: 1, jobs: [...jobs.values()].sort((a, b) => a.id.localeCompare(b.id)).map(j => {
      const x = { id: j.id, dependsOn: [...j.dependsOn], payload: j.payload, status: j.status, attempt: j.attempt };
      if (Object.hasOwn(j, 'result')) x.result = j.result;
      if (Object.hasOwn(j, 'error')) x.error = j.error;
      return x;
    }) };
  }
  function writeSync() {
    fs.mkdirSync(directory, { recursive: true });
    const tmp = path.join(directory, `.${path.basename(file)}.tmp-${process.pid}-${++tempCounter}`);
    fs.writeFileSync(tmp, JSON.stringify(checkpoint()), 'utf8'); fs.renameSync(tmp, file);
  }
  async function write() {
    await fsp.mkdir(directory, { recursive: true });
    const tmp = path.join(directory, `.${path.basename(file)}.tmp-${process.pid}-${++tempCounter}`);
    try { await fsp.writeFile(tmp, JSON.stringify(checkpoint()), 'utf8'); await fsp.rename(tmp, file); }
    catch (e) { try { await fsp.unlink(tmp); } catch (_) {} throw e; }
  }
  function acyclic() {
    const visiting = new Set(), visited = new Set();
    function visit(id) {
      if (visiting.has(id)) throw new Error('dependency cycle');
      if (visited.has(id)) return;
      visiting.add(id); for (const dep of jobs.get(id).dependsOn) visit(dep);
      visiting.delete(id); visited.add(id);
    }
    for (const id of jobs.keys()) visit(id);
  }
  function load() {
    if (!fs.existsSync(file)) return;
    let data; try { data = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { throw new Error(`corrupt checkpoint: ${e.message}`); }
    if (!data || data.version !== 1 || !Array.isArray(data.jobs)) throw new Error('corrupt checkpoint');
    for (const raw of data.jobs) {
      if (!raw || typeof raw !== 'object' || !ID.test(raw.id) || jobs.has(raw.id) || !Array.isArray(raw.dependsOn) ||
          raw.dependsOn.some(d => typeof d !== 'string' || !ID.test(d)) || !STATUSES.has(raw.status) || !Number.isInteger(raw.attempt) || raw.attempt < 0 ||
          Object.keys(raw).some(k => !['id','dependsOn','payload','status','attempt','result','error'].includes(k))) throw new Error('corrupt checkpoint');
      jobs.set(raw.id, { id: raw.id, dependsOn: [...raw.dependsOn], payload: raw.payload === undefined ? null : raw.payload, status: raw.status, attempt: raw.attempt,
        ...(Object.hasOwn(raw, 'result') ? { result: raw.result } : {}), ...(Object.hasOwn(raw, 'error') ? { error: String(raw.error) } : {}) });
    }
    for (const j of jobs.values()) if (new Set(j.dependsOn).size !== j.dependsOn.length || j.dependsOn.includes(j.id) || j.dependsOn.some(d => !jobs.has(d))) throw new Error('corrupt checkpoint');
    acyclic(); let recovered = false;
    for (const j of jobs.values()) if (j.status === 'running') { j.status = 'pending'; recovered = true; }
    if (recovered) writeSync();
  }
  load();

  async function enqueue(batch) {
    if (!Array.isArray(batch)) throw new TypeError('jobs must be an array');
    const additions = [], seen = new Set();
    for (const raw of batch) {
      if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new TypeError('job must be an object');
      if (Object.keys(raw).some(k => !['id','dependsOn','payload'].includes(k))) throw new Error('unknown job field');
      const deps = raw.dependsOn === undefined ? [] : raw.dependsOn;
      if (typeof raw.id !== 'string' || !ID.test(raw.id)) throw new Error(`invalid job id: ${raw.id}`);
      if (seen.has(raw.id) || jobs.has(raw.id)) throw new Error(`duplicate job id: ${raw.id}`);
      if (!Array.isArray(deps) || deps.some(d => typeof d !== 'string' || !ID.test(d)) || new Set(deps).size !== deps.length || deps.includes(raw.id)) throw new Error('invalid dependencies');
      const payload = raw.payload === undefined ? null : raw.payload;
      try { JSON.stringify(payload); } catch (_) { throw new Error('payload must be JSON serializable'); }
      seen.add(raw.id); additions.push({ id: raw.id, dependsOn: [...deps], payload, status: 'pending', attempt: 0 });
    }
    for (const j of additions) jobs.set(j.id, j);
