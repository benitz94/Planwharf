--- /dev/null
+++ b/test.cjs
@@ -0,0 +1,81 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const { createScheduler } = require('./scheduler.cjs');
+
+async function checkpointPath() {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'scheduler-'));
+  return path.join(dir, 'state.json');
+}
+
+test('validates options and atomically rejects invalid batches', async () => {
+  const file = await checkpointPath();
+  assert.throws(() => createScheduler({ file, concurrency: 0, execute() {} }), /concurrency/);
+  assert.throws(() => createScheduler({ file, execute: 1 }), /execute/);
+  const scheduler = createScheduler({ file, execute: async () => 1 });
+  await assert.rejects(scheduler.enqueue([{ id: 'ok' }, { id: 'bad!', dependsOn: ['missing'] }]), /invalid job id/);
+  assert.deepEqual(scheduler.snapshot().jobs, []);
+  await assert.rejects(scheduler.enqueue([{ id: 'a', dependsOn: ['missing'] }]), /unknown dependency/);
+  assert.deepEqual(scheduler.snapshot().jobs, []);
+});
+
+test('runs dependencies in order and respects concurrency', async () => {
+  const file = await checkpointPath();
+  let active = 0;
+  let maximum = 0;
+  const seen = [];
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async ({ id, payload, attempt }) => {
+    active += 1; maximum = Math.max(maximum, active); seen.push(`${id}:${payload}:${attempt}`);
+    await new Promise(resolve => setTimeout(resolve, id === 'a' ? 15 : 2));
+    active -= 1;
+    return { id };
+  }});
+  await scheduler.enqueue([
+    { id: 'b', dependsOn: ['a'], payload: 'B' },
+    { id: 'a', payload: 'A' },
+    { id: 'c', payload: 'C' }
+  ]);
+  const result = await Promise.all([scheduler.run(), scheduler.run()]);
+  assert.equal(maximum, 2);
+  assert.deepEqual(seen.slice(0, 2).sort(), ['a:A:1', 'c:C:1']);
+  assert.equal(seen[2], 'b:B:1');
+  assert.deepEqual(result[0], result[1]);
+  assert.deepEqual(scheduler.snapshot().jobs.map(j => j.status), ['completed', 'completed', 'completed']);
+  await scheduler.run();
+  assert.equal(seen.length, 3);
+});
+
+test('fails and transitively blocks descendants while continuing independent work', async () => {
+  const file = await checkpointPath();
+  const executed = [];
+  const scheduler = createScheduler({ file, execute: async ({ id }) => {
+    executed.push(id);
+    if (id === 'root') throw new Error('nope');
+    return id;
+  }});
+  await scheduler.enqueue([{ id: 'leaf', dependsOn: ['mid'] }, { id: 'mid', dependsOn: ['root'] }, { id: 'root' }, { id: 'other' }]);
+  const result = await scheduler.run();
+  assert.deepEqual(executed.sort(), ['other', 'root']);
+  assert.equal(result.jobs.find(j => j.id === 'root').error, 'nope');
+  assert.equal(result.jobs.find(j => j.id === 'mid').status, 'blocked');
+  assert.equal(result.jobs.find(j => j.id === 'leaf').status, 'blocked');
+});
+
+test('recovers running work and retains completed results', async () => {
+  const file = await checkpointPath();
+  const first = createScheduler({ file, execute: async () => 'done' });
+  await first.enqueue([{ id: 'job' }]);
+  await fs.writeFile(file, JSON.stringify({ version: 1, jobs: [{ id: 'job', dependsOn: [], payload: null, status: 'running', attempt: 1 }] }));
+  const attempts = [];
+  const second = createScheduler({ file, execute: async ({ attempt }) => { attempts.push(attempt); return 'recovered'; } });
+  assert.equal(second.snapshot().jobs[0].status, 'pending');
+  await second.run();
+  assert.deepEqual(attempts, [2]);
+  const third = createScheduler({ file, execute: async () => { throw new Error('replayed'); } });
+  await third.run();
+  assert.equal(third.snapshot().jobs[0].result, 'recovered');
