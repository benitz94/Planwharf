      }
      if (!active.size) break;
      await Promise.race(active);
    }
    return snapshot();
  }
  function run() { if (!drainPromise) drainPromise = drain().finally(() => { drainPromise = null; }); return drainPromise; }
  function snapshot() { return clone(checkpoint()); }
  return { enqueue, run, snapshot };
}
module.exports = { createScheduler };
