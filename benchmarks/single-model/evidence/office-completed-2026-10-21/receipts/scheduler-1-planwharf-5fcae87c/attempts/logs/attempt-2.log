  }
  async function claim(j) { j.status = 'running'; j.attempt += 1; await write(); if (onStage) await onStage('claimed', j.id); }
  async function drain() {
    const active = new Set();
    while (true) {
      while (active.size < concurrency) {
        const next = [...jobs.values()].filter(ready).sort((a, b) => a.id.localeCompare(b.id))[0];
        if (!next) break;
        await claim(next);
        const task = (async () => { try { await finish(next, 'completed', await execute({ id: next.id, payload: clone(next.payload), attempt: next.attempt })); } catch (e) { await finish(next, 'failed', e instanceof Error ? e.message : String(e)); } })();
