+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+const ID = /^[a-z][a-z0-9-]{0,31}$/;
+const STATES = new Set(['pending', 'running', 'completed', 'failed', 'blocked']);
+
+function clone(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function createScheduler(options) {
+  if (!options || typeof options !== 'object') throw new TypeError('options are required');
+  const { file, concurrency, execute, onStage } = options;
+  if (typeof file !== 'string' || file.length === 0) throw new TypeError('file must be a non-empty string');
+  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) {
+    throw new TypeError('concurrency must be an integer from 1 to 8');
+  }
+  if (typeof execute !== 'function') throw new TypeError('execute must be a function');
+  if (onStage !== undefined && typeof onStage !== 'function') throw new TypeError('onStage must be a function');
+
+  const directory = path.dirname(path.resolve(file));
+  fs.mkdirSync(directory, { recursive: true });
+  let state;
+  if (fs.existsSync(file)) {
+    let parsed;
+    try { parsed = JSON.parse(fs.readFileSync(file, 'utf8')); }
+    catch (error) { throw new Error(`corrupt checkpoint: ${error.message}`); }
+    if (!parsed || parsed.version !== 1 || !Array.isArray(parsed.jobs)) throw new Error('corrupt checkpoint');
+    state = new Map();
+    try {
+      for (const job of parsed.jobs) {
+        if (!job || typeof job.id !== 'string' || !ID.test(job.id) || state.has(job.id) ||
+            !Array.isArray(job.dependsOn) || job.dependsOn.some(dep => typeof dep !== 'string') ||
+            !STATES.has(job.status) || !Number.isInteger(job.attempt) || job.attempt < 0) throw new Error('invalid job');
+        state.set(job.id, {
+          id: job.id, dependsOn: [...job.dependsOn], payload: job.payload === undefined ? null : clone(job.payload),
+          status: job.status === 'running' ? 'pending' : job.status, attempt: job.attempt,
+          ...(Object.prototype.hasOwnProperty.call(job, 'result') ? { result: clone(job.result) } : {}),
+          ...(Object.prototype.hasOwnProperty.call(job, 'error') ? { error: String(job.error) } : {})
+        });
+      }
+      for (const job of state.values()) {
+        if (job.dependsOn.some(dep => !state.has(dep) || dep === job.id || job.dependsOn.indexOf(dep) !== job.dependsOn.lastIndexOf(dep))) throw new Error('invalid dependency');
+      }
+      assertAcyclic(state);
+    } catch (error) { throw new Error(`corrupt checkpoint: ${error.message}`); }
+    if ([...state.values()].some(job => parsed.jobs.find(item => item.id === job.id).status === 'running')) persist(state);
+  } else state = new Map();
+
+  let runPromise = null;
+  let executing = 0;
+
+  function snapshotFrom(map = state) {
+    return { version: 1, jobs: [...map.values()].sort((a, b) => a.id.localeCompare(b.id)).map(job => clone(job)) };
+  }
+  function persist(map) {
+    const contents = JSON.stringify(snapshotFrom(map));
+    const temp = path.join(directory, `.${path.basename(file)}.${process.pid}.${Date.now()}.${Math.random().toString(16).slice(2)}.tmp`);
+    fs.writeFileSync(temp, contents, 'utf8');
+    fs.renameSync(temp, file);
+  }
+  async function stage(name, id) { if (onStage) await onStage(name, id); }
+
+  async function enqueue(jobs) {
+    if (!Array.isArray(jobs)) throw new TypeError('jobs must be an array');
+    const candidate = new Map(state);
+    const batch = new Set();
+    for (const input of jobs) {
+      if (!input || typeof input !== 'object' || Array.isArray(input)) throw new TypeError('invalid job');
+      const keys = Object.keys(input);
+      if (keys.some(key => !['id', 'dependsOn', 'payload'].includes(key))) throw new TypeError('unknown job field');
+      const id = input.id;
+      if (typeof id !== 'string' || !ID.test(id)) throw new TypeError('invalid job id');
+      if (candidate.has(id) || batch.has(id)) throw new Error(`duplicate job id: ${id}`);
+      const dependsOn = input.dependsOn === undefined ? [] : input.dependsOn;
+      if (!Array.isArray(dependsOn) || dependsOn.some(dep => typeof dep !== 'string' || !ID.test(dep))) throw new TypeError('invalid dependency list');
+      if (new Set(dependsOn).size !== dependsOn.length || dependsOn.includes(id)) throw new Error(`invalid dependencies for ${id}`);
+      batch.add(id);
+      candidate.set(id, { id, dependsOn: [...dependsOn], payload: input.payload === undefined ? null : clone(input.payload), status: 'pending', attempt: 0 });
+    }
+    for (const job of candidate.values()) for (const dep of job.dependsOn) if (!candidate.has(dep)) throw new Error(`unknown dependency: ${dep}`);
+    assertAcyclic(candidate);
+    // Serialize before mutating the live map, preserving atomic rejection for unserializable payloads.
+    JSON.stringify(snapshotFrom(candidate));
+    persist(candidate);
+    state = candidate;
+  }
+
+  function readyJobs() {
+    return [...state.values()].filter(job => job.status === 'pending' && job.dependsOn.every(dep => state.get(dep).status === 'completed')).sort((a, b) => a.id.localeCompare(b.id));
+  }
+  async function blockDescendants() {
+    let changed = true;
+    while (changed) {
+      changed = false;
+      for (const job of [...state.values()].sort((a, b) => a.id.localeCompare(b.id))) {
+        if (job.status === 'pending' && job.dependsOn.some(dep => ['failed', 'blocked'].includes(state.get(dep).status))) {
+          job.status = 'blocked'; persist(state); changed = true;
+        }
+      }
+    }
+  }
+  async function claim(job) {
+    job.status = 'running'; job.attempt += 1; persist(state); await stage('claimed', job.id);
+    let result;
+    try {
+      result = await execute({ id: job.id, payload: clone(job.payload), attempt: job.attempt });
+      job.result = clone(result); delete job.error; job.status = 'completed'; persist(state);
+    } catch (error) {
+      delete job.result; job.error = String(error); job.status = 'failed'; persist(state); await blockDescendants();
+      return;
+    }
+    await stage('completed', job.id);
+  }
