+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { createScheduler } = require('./scheduler.cjs');
+
+async function tempFile() { return path.join(await fs.mkdtemp(path.join(os.tmpdir(), 'scheduler-')), 'nested', 'checkpoint.json'); }
+
+test('runs dependencies in id order, persists results, and blocks descendants', async () => {
+  const file = await tempFile(); const calls = [];
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async job => { calls.push(job.id); if (job.id === 'bad') throw new Error('nope'); return job.payload; } });
+  await scheduler.enqueue([{ id: 'z', dependsOn: ['a'], payload: 3 }, { id: 'a', payload: 1 }, { id: 'bad' }, { id: 'child', dependsOn: ['bad'] }]);
+  const result = await scheduler.run();
+  assert.deepEqual(calls, ['a', 'bad', 'z']);
+  assert.equal(result.jobs.find(j => j.id === 'z').status, 'completed');
+  assert.equal(result.jobs.find(j => j.id === 'child').status, 'blocked');
+  assert.equal(JSON.parse(await fs.readFile(file, 'utf8')).jobs.length, 4);
+  await scheduler.run(); assert.deepEqual(calls, ['a', 'bad']);
+});
+
+test('rejects invalid batches atomically and recovers running jobs', async () => {
+  const file = await tempFile(); const scheduler = createScheduler({ file, concurrency: 1, execute: async () => 1 });
+  await scheduler.enqueue([{ id: 'base' }]); const before = await fs.readFile(file, 'utf8');
+  await assert.rejects(scheduler.enqueue([{ id: 'ok' }, { id: 'bad!', dependsOn: ['missing'] }]));
+  assert.equal(await fs.readFile(file, 'utf8'), before); assert.equal(scheduler.snapshot().jobs.length, 1);
+  const stages = []; const second = createScheduler({ file, concurrency: 1, execute: async job => job.attempt, onStage: async (stage, id) => stages.push(`${stage}:${id}`) });
+  await second.run(); assert.equal(second.snapshot().jobs[0].attempt, 1); assert.ok(stages.includes('completed:base'));
+});
+
+test('concurrent runs join and respect concurrency', async () => {
+  const file = await tempFile(); let active = 0; let max = 0; let count = 0;
+  const scheduler = createScheduler({ file, concurrency: 2, execute: async () => { count++; active++; max = Math.max(max, active); await new Promise(r => setTimeout(r, 5)); active--; return count; } });
+  await scheduler.enqueue(Array.from({ length: 8 }, (_, i) => ({ id: `job-${i}` })));
+  const [a, b] = await Promise.all([scheduler.run(), scheduler.run()]);
+  assert.deepEqual(a, b); assert.equal(count, 8); assert.ok(max <= 2);
+});

