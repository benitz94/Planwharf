+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { createScheduler } = require('./scheduler.cjs');
+
+async function tempFile() { const d = await fs.mkdtemp(path.join(os.tmpdir(), 'scheduler-')); return path.join(d, 'state.json'); }
+
+test('runs dependencies in id order with concurrency and persists results', async () => {
+  const file = await tempFile(); const calls = [];
+  const s = createScheduler({ file, concurrency: 2, execute: async j => { calls.push(j.id); return j.payload + 1; } });
+  await s.enqueue([{ id: 'b', dependsOn: ['a'], payload: 2 }, { id: 'a', payload: 4 }]);
+  const out = await s.run();
+  assert.deepEqual(calls, ['a', 'b']); assert.equal(out.jobs[1].result, 3);
+  assert.deepEqual(s.snapshot(), out); assert.equal(JSON.parse(await fs.readFile(file, 'utf8')).version, 1);
+});
+
+test('rejects invalid batches atomically and blocks descendants', async () => {
+  const file = await tempFile(); let calls = 0;
+  const s = createScheduler({ file, concurrency: 1, execute: async () => { calls++; throw new Error('nope'); } });
+  await assert.rejects(s.enqueue([{ id: 'ok' }, { id: 'bad!', dependsOn: ['ok'] }]));
+  assert.equal(s.snapshot().jobs.length, 0);
+  await s.enqueue([{ id: 'a' }, { id: 'b', dependsOn: ['a'] }, { id: 'c', dependsOn: ['b'] }]);
+  const out = await s.run(); assert.equal(calls, 1); assert.equal(out.jobs.find(j => j.id === 'c').status, 'blocked');
+});
+
+test('joins concurrent run calls and recovers running checkpoints', async () => {
+  const file = await tempFile(); let calls = 0; let release;
+  const s = createScheduler({ file, concurrency: 1, execute: async () => { calls++; await new Promise(r => { release = r; }); return 'done'; } });
+  await s.enqueue([{ id: 'job' }]); const p1 = s.run(); const p2 = s.run();
+  while (!release) await new Promise(r => setImmediate(r)); release(); await Promise.all([p1, p2]); assert.equal(calls, 1);
+  const s2 = createScheduler({ file, concurrency: 1, execute: async j => { calls++; return j.attempt; } });
+  assert.equal((await s2.run()).jobs[0].status, 'completed'); assert.equal(calls, 1);
+});

