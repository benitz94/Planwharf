+'use strict';
+
+const fs = require('node:fs');
+const fsp = fs.promises;
+const path = require('node:path');
+
+const ID = /^[a-z][a-z0-9-]{0,31}$/;
+const FIELDS = new Set(['id', 'dependsOn', 'payload']);
+const JOB_FIELDS = new Set(['id', 'dependsOn', 'payload', 'status', 'attempt', 'result', 'error']);
+
+function ownKeysOnly(value, allowed) {
+  return value && typeof value === 'object' && !Array.isArray(value) && Object.keys(value).every(k => allowed.has(k));
+}
+
+function clone(value) {
+  return JSON.parse(JSON.stringify(value));
+}
+
+function createScheduler(options) {
+  if (!options || typeof options !== 'object') throw new TypeError('options must be an object');
+  const { file, concurrency, execute, onStage } = options;
+  if (typeof file !== 'string' || !file) throw new TypeError('file must be a non-empty string');
+  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) throw new RangeError('concurrency must be an integer from 1 to 8');
+  if (typeof execute !== 'function') throw new TypeError('execute must be a function');
+  if (onStage !== undefined && typeof onStage !== 'function') throw new TypeError('onStage must be a function');
+
+  const jobs = new Map();
+  let writeTail = Promise.resolve();
+  let drainPromise = null;
+
+  function checkpoint() {
+    return { version: 1, jobs: [...jobs.values()].sort((a, b) => a.id.localeCompare(b.id)).map(j => clone(j)) };
+  }
+
+  function queuePersist() {
+    let data;
+    try { data = JSON.stringify(checkpoint()) + '\n'; }
+    catch (e) { throw new TypeError(`checkpoint is not JSON-serializable: ${e.message}`); }
+    const tmp = `${file}.tmp-${process.pid}-${Date.now()}-${Math.random().toString(36).slice(2)}`;
+    writeTail = writeTail.then(async () => {
+      await fsp.mkdir(path.dirname(path.resolve(file)), { recursive: true });
+      await fsp.writeFile(tmp, data, 'utf8');
+      await fsp.rename(tmp, file);
+    }).catch(async e => { try { await fsp.unlink(tmp); } catch {} throw e; });
+    return writeTail;
+  }
+
+  function validateLoaded(raw) {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw) || raw.version !== 1 || !Array.isArray(raw.jobs)) throw new Error('invalid checkpoint');
+    const seen = new Set();
+    for (const j of raw.jobs) {
+      if (!ownKeysOnly(j, JOB_FIELDS) || typeof j.id !== 'string' || !ID.test(j.id) || seen.has(j.id)) throw new Error('invalid checkpoint job');
+      seen.add(j.id);
+      if (!Array.isArray(j.dependsOn) || j.dependsOn.some(d => typeof d !== 'string' || !ID.test(d)) || new Set(j.dependsOn).size !== j.dependsOn.length) throw new Error('invalid checkpoint dependencies');
+      if (!['pending', 'running', 'completed', 'failed', 'blocked'].includes(j.status) || !Number.isInteger(j.attempt) || j.attempt < 0) throw new Error('invalid checkpoint status');
+      if (j.status === 'completed' && !Object.prototype.hasOwnProperty.call(j, 'result')) throw new Error('completed job lacks result');
+      if (j.status === 'failed' && typeof j.error !== 'string') throw new Error('failed job lacks error');
+    }
+    for (const j of raw.jobs) for (const d of j.dependsOn) if (!seen.has(d) || d === j.id) throw new Error('invalid checkpoint dependency');
+    const map = new Map(raw.jobs.map(j => [j.id, j]));
+    const visiting = new Set(), visited = new Set();
+    function visit(id) { if (visiting.has(id)) throw new Error('checkpoint contains a cycle'); if (visited.has(id)) return; visiting.add(id); for (const d of map.get(id).dependsOn) visit(d); visiting.delete(id); visited.add(id); }
+    for (const j of raw.jobs) visit(j.id);
+    for (const j of raw.jobs) jobs.set(j.id, { ...clone(j), ...(j.status === 'running' ? { status: 'pending' } : {}) });
+  }
+
+  try {
+    if (fs.existsSync(file)) validateLoaded(JSON.parse(fs.readFileSync(file, 'utf8')));
+  } catch (e) { throw new Error(`cannot load checkpoint: ${e.message}`); }
+
+  function validateBatch(input) {
+    if (!Array.isArray(input)) throw new TypeError('jobs must be an array');
+    const ids = new Set();
+    for (const j of input) {
+      if (!ownKeysOnly(j, FIELDS) || typeof j.id !== 'string' || !ID.test(j.id)) throw new TypeError('invalid job');
+      if (ids.has(j.id) || jobs.has(j.id)) throw new Error(`duplicate job id: ${j.id}`);
+      ids.add(j.id);
+      if (j.dependsOn !== undefined && (!Array.isArray(j.dependsOn) || j.dependsOn.some(d => typeof d !== 'string' || !ID.test(d)) || new Set(j.dependsOn).size !== j.dependsOn.length || j.dependsOn.includes(j.id))) throw new Error(`invalid dependencies for ${j.id}`);
+    }
+    for (const j of input) for (const d of (j.dependsOn || [])) if (!ids.has(d) && !jobs.has(d)) throw new Error(`unknown dependency: ${d}`);
+    const all = new Map([...jobs].map(([id, j]) => [id, j.dependsOn]));
+    for (const j of input) all.set(j.id, j.dependsOn || []);
+    const visiting = new Set(), visited = new Set();
+    function visit(id) { if (visiting.has(id)) throw new Error('dependency cycle'); if (visited.has(id)) return; visiting.add(id); for (const d of all.get(id)) visit(d); visiting.delete(id); visited.add(id); }
+    for (const j of input) visit(j.id);
+    return input.map(j => ({ id: j.id, dependsOn: [...(j.dependsOn || [])], payload: j.payload === undefined ? null : j.payload, status: 'pending', attempt: 0 }));
+  }
+
+  async function enqueue(input) {
+    // Validation occurs before any mutation, preserving atomic rejection.
+    const additions = validateBatch(input);
+    for (const j of additions) jobs.set(j.id, j);
+    try { await queuePersist(); } catch (e) { for (const j of additions) jobs.delete(j.id); throw e; }
+  }
+
+  async function stage(name, id) { if (onStage) await onStage(name, id); }
+
+  async function markBlocked() {
+    let changed = false;
+    for (const j of [...jobs.values()].sort((a, b) => a.id.localeCompare(b.id))) {
+      if (j.status === 'pending' && j.dependsOn.some(d => ['failed', 'blocked'].includes(jobs.get(d).status))) {
+        j.status = 'blocked'; await queuePersist(); await stage('completed', j.id); changed = true;
+      }
+    }
+    return changed;
+  }
+
+  async function drain() {
+    const running = new Set();
+    while (true) {
+      await markBlocked();
+      while (running.size < concurrency) {
+        const next = [...jobs.values()].filter(j => j.status === 'pending' && j.dependsOn.every(d => jobs.get(d).status === 'completed')).sort((a, b) => a.id.localeCompare(b.id))[0];
+        if (!next) break;
+        next.status = 'running'; next.attempt += 1;
+        await queuePersist(); await stage('claimed', next.id);
+        const task = (async () => {
+          try {
+            const result = await execute({ id: next.id, payload: clone(next.payload), attempt: next.attempt });
+            next.result = clone(result); next.status = 'completed';
+            delete next.error;
+          } catch (e) { next.error = e instanceof Error ? e.message : String(e); next.status = 'failed'; delete next.result; }
+          await queuePersist(); await stage('completed', next.id);
+        })();
+        running.add(task);
+        task.finally(() => running.delete(task));
+      }
+      if (!running.size) {
+        const pending = [...jobs.values()].some(j => j.status === 'pending');
