+        // A valid graph cannot reach this point except through an impossible state.
+        throw new Error('scheduler has unresolved pending jobs');
+      }
+      await Promise.race(running);
+    }
+  }
+
+  function run() { if (!drainPromise) drainPromise = drain().finally(() => { drainPromise = null; }); return drainPromise; }
