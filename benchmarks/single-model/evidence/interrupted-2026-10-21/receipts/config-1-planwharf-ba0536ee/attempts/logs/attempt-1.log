 'use strict';
-// Implement the public contract in TASK.md.
-module.exports = {};
+
+const DEFAULTS = Object.freeze({
+  port: 3000,
+  host: '127.0.0.1',
+  retries: 2,
+  logLevel: 'info',
+});
+const KEYS = new Set(Object.keys(DEFAULTS));
+const LOG_LEVELS = new Set(['debug', 'info', 'warn', 'error']);
+
+function invalid(message) {
+  throw new Error(`Invalid configuration: ${message}`);
+}
+
+function parseConfig(text) {
+  if (typeof text !== 'string') {
+    invalid('input must be a JSON string');
+  }
+
+  let value;
+  try {
+    value = JSON.parse(text);
+  } catch {
+    invalid('input is not valid JSON');
+  }
+
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    invalid('top-level value must be a plain object');
+  }
+
+  for (const key of Object.keys(value)) {
+    if (!KEYS.has(key)) invalid(`unknown key: ${key}`);
+  }
+
+  const port = value.port === undefined ? DEFAULTS.port : value.port;
+  const retries = value.retries === undefined ? DEFAULTS.retries : value.retries;
+  const host = value.host === undefined ? DEFAULTS.host : value.host;
+  const logLevel = value.logLevel === undefined ? DEFAULTS.logLevel : value.logLevel;
+
+  if (!Number.isInteger(port) || port < 1 || port > 65535) {
+    invalid('port must be an integer from 1 to 65535');
+  }
+  if (!Number.isInteger(retries) || retries < 0 || retries > 10) {
+    invalid('retries must be an integer from 0 to 10');
+  }
+  if (typeof host !== 'string' || host.length < 1 || host.length > 253 || /\s/u.test(host)) {
+    invalid('host must be 1 to 253 characters with no whitespace');
+  }
+  if (typeof logLevel !== 'string' || !LOG_LEVELS.has(logLevel)) {
+    invalid('logLevel must be debug, info, warn, or error');
+  }
+
+  return { port, host, retries, logLevel };
+}
+
+module.exports = { parseConfig };
diff --git a/test.cjs b/test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..077a53b686777913cff3d6d28aadf416cd81426d
--- /dev/null
+++ b/test.cjs
@@ -0,0 +1,50 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parseConfig } = require('./config.cjs');
+
+test('uses defaults for an empty object', () => {
+  assert.deepEqual(parseConfig('{}'), {
+    port: 3000,
+    host: '127.0.0.1',
+    retries: 2,
+    logLevel: 'info',
+  });
+});
+
+test('accepts valid overrides and returns only the public fields', () => {
+  assert.deepEqual(parseConfig(JSON.stringify({
+    port: 65535, host: 'service.example', retries: 0, logLevel: 'debug',
+  })), {
+    port: 65535, host: 'service.example', retries: 0, logLevel: 'debug',
+  });
+});
+
+test('rejects malformed input, non-objects, and unknown keys', () => {
+  for (const input of [42, null, [], '{', 'null', '[]', '{"extra":true}']) {
+    assert.throws(() => parseConfig(input));
+  }
+});
+
+test('rejects null, wrong types, fractions, ranges, and whitespace hosts', () => {
+  const invalidConfigs = [
+    { port: null }, { port: 1.5 }, { port: 0 }, { port: 65536 },
+    { retries: null }, { retries: 1.5 }, { retries: -1 }, { retries: 11 },
+    { host: null }, { host: '' }, { host: 'has space' }, { host: 'has\nnewline' },
+    { logLevel: null }, { logLevel: 'trace' },
+  ];
+  for (const config of invalidConfigs) {
+    assert.throws(() => parseConfig(JSON.stringify(config)));
+  }
+  assert.throws(() => parseConfig({}));
+});
+
+test('does not coerce strings and returns independent result objects', () => {
+  assert.throws(() => parseConfig(JSON.stringify({ port: '3000' })));
+  const first = parseConfig('{}');
+  first.port = 1234;
+  assert.deepEqual(parseConfig('{}'), {
+    port: 3000, host: '127.0.0.1', retries: 2, logLevel: 'info',
+  });
+});

