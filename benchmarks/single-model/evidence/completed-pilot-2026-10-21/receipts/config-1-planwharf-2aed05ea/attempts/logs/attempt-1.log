 'use strict';
-// Implement the public contract in TASK.md.
-module.exports = {};
+
+const DEFAULTS = Object.freeze({
+  port: 3000,
+  host: '127.0.0.1',
+  retries: 2,
+  logLevel: 'info',
+});
+const LOG_LEVELS = new Set(['debug', 'info', 'warn', 'error']);
+const ALLOWED_KEYS = new Set(Object.keys(DEFAULTS));
+
+function invalid(message) {
+  throw new Error(`Invalid configuration: ${message}`);
+}
+
+function parseConfig(text) {
+  if (typeof text !== 'string') {
+    invalid('input must be a JSON string');
+  }
+
+  let input;
+  try {
+    input = JSON.parse(text);
+  } catch {
+    invalid('input is not valid JSON');
+  }
+
+  if (input === null || Array.isArray(input) || typeof input !== 'object') {
+    invalid('JSON value must be an object');
+  }
+
+  for (const key of Object.keys(input)) {
+    if (!ALLOWED_KEYS.has(key)) {
+      invalid(`unknown key: ${key}`);
+    }
+  }
+
+  const result = {
+    port: input.port === undefined ? DEFAULTS.port : input.port,
+    host: input.host === undefined ? DEFAULTS.host : input.host,
+    retries: input.retries === undefined ? DEFAULTS.retries : input.retries,
+    logLevel: input.logLevel === undefined ? DEFAULTS.logLevel : input.logLevel,
+  };
+
+  if (!Number.isInteger(result.port) || result.port < 1 || result.port > 65535) {
+    invalid('port must be an integer from 1 to 65535');
+  }
+  if (!Number.isInteger(result.retries) || result.retries < 0 || result.retries > 10) {
+    invalid('retries must be an integer from 0 to 10');
+  }
+  if (typeof result.host !== 'string' || result.host.length < 1 || result.host.length > 253 || /\s/u.test(result.host)) {
+    invalid('host must be 1 to 253 characters without whitespace');
+  }
+  if (typeof result.logLevel !== 'string' || !LOG_LEVELS.has(result.logLevel)) {
+    invalid('logLevel must be debug, info, warn, or error');
+  }
+
+  return result;
+}
+
+module.exports = { parseConfig };
diff --git a/test.cjs b/test.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..946dac2f1775a06fef41b21798f43005045bd031
--- /dev/null
+++ b/test.cjs
@@ -0,0 +1,44 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { parseConfig } = require('./config.cjs');
+
+test('uses defaults and returns the documented keys', () => {
+  assert.deepStrictEqual(parseConfig('{}'), {
+    port: 3000,
+    host: '127.0.0.1',
+    retries: 2,
+    logLevel: 'info',
+  });
+});
+
+test('accepts valid overrides', () => {
+  const config = parseConfig(JSON.stringify({ port: 65535, host: 'api.example', retries: 0, logLevel: 'debug' }));
+  assert.deepStrictEqual(config, { port: 65535, host: 'api.example', retries: 0, logLevel: 'debug' });
+  assert.notStrictEqual(config, parseConfig('{}'));
+});
+
+test('rejects malformed input, non-objects, and unknown keys', () => {
+  for (const input of [42, null, [], 'not json', '{"extra":true}']) {
+    assert.throws(() => parseConfig(input));
+  }
+});
+
+test('rejects explicit null, incorrect types, and invalid ranges', () => {
+  const invalidConfigs = [
+    { port: null }, { port: 0 }, { port: 65536 }, { port: 1.5 }, { port: '3000' },
+    { host: null }, { host: '' }, { host: 'a b' }, { host: 'a\n' }, { host: 'x'.repeat(254) },
+    { retries: null }, { retries: -1 }, { retries: 11 }, { retries: 1.1 }, { retries: '2' },
+    { logLevel: null }, { logLevel: 'trace' }, { logLevel: 1 },
+  ];
+  for (const config of invalidConfigs) {
+    assert.throws(() => parseConfig(JSON.stringify(config)), Error);
+  }
+});
+
+test('does not share mutable result state', () => {
+  const first = parseConfig('{}');
+  first.port = 8080;
+  assert.equal(parseConfig('{}').port, 3000);
+});

