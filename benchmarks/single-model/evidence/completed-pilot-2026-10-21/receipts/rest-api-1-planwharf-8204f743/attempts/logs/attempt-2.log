+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { createServer } = require('./api.cjs');
+
+async function withServer(fn, options = {}) {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'rest-items-'));
+  const file = path.join(dir, 'nested', 'items.json');
+  const server = createServer({ file, ...options });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  const address = server.address();
+  try { return await fn(`http://127.0.0.1:${address.port}`, file); }
+  finally { await new Promise(resolve => server.close(resolve)); await fs.rm(dir, { recursive: true, force: true }); }
+}
+
+async function request(base, method, route, body) {
+  const response = await fetch(base + route, { method, headers: body === undefined ? undefined : { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
+  const text = await response.text();
+  return { response, body: text ? JSON.parse(text) : undefined };
+}
+
+test('CRUD persists, validates, sorts, and creates parent directories', async () => {
+  await withServer(async (base, file) => {
+    assert.equal((await request(base, 'POST', '/items', { id: 'z-item', title: '  Zed  ' })).response.status, 201);
+    const created = await request(base, 'POST', '/items', { id: 'a-item', title: 'Alpha', done: true });
+    assert.deepEqual(created.body, { id: 'a-item', title: 'Alpha', done: true });
+    assert.equal(created.response.headers.get('location'), '/items/a-item');
+    assert.deepEqual((await request(base, 'GET', '/items')).body.map(x => x.id), ['a-item', 'z-item']);
+    assert.deepEqual((await request(base, 'PATCH', '/items/z-item', { done: true })).body, { id: 'z-item', title: 'Zed', done: true });
+    assert.equal((await request(base, 'DELETE', '/items/a-item')).response.status, 204);
+    assert.deepEqual(JSON.parse(await fs.readFile(file, 'utf8')), { version: 1, items: [{ id: 'z-item', title: 'Zed', done: true }] });
+  });
+});
+
+test('rejects malformed input and unknown routes without committing', async () => {
+  await withServer(async (base, file) => {
+    for (const body of [{ id: 'Bad', title: 'x' }, { id: 'ok', title: 'x', extra: 1 }, { id: 'ok', title: '' }]) {
+      assert.equal((await request(base, 'POST', '/items', body)).response.status, 400);
+    }
+    const malformed = await fetch(base + '/items', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{' });
+    assert.equal(malformed.status, 400);
+    assert.equal((await request(base, 'GET', '/unknown')).response.status, 404);
+    assert.deepEqual(JSON.parse(await fs.readFile(file, 'utf8')), { version: 1, items: [] });
+  });
+});
+
+test('serializes concurrent mutations and rejects oversized bodies', async () => {
+  await withServer(async base => {
+    const responses = await Promise.all(Array.from({ length: 12 }, (_, i) => request(base, 'POST', '/items', { id: `item-${i}`, title: `Item ${i}` })));
+    assert.ok(responses.every(x => x.response.status === 201));
+    assert.equal((await request(base, 'GET', '/items')).body.length, 12);
+    const oversized = await fetch(base + '/items', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: 'large', title: 'x'.repeat(20000) }) });
+    assert.equal(oversized.status, 413);
+    assert.equal((await request(base, 'GET', '/items/large')).response.status, 404);
+  });
+});
+
+test('malformed existing stores fail closed and staging hooks run around durable commits', async () => {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'rest-items-malformed-'));
+  const file = path.join(dir, 'items.json');
+  await fs.writeFile(file, '{not-json');
+  const server = createServer({ file });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  try { const address = server.address(); assert.equal((await request(`http://127.0.0.1:${address.port}`, 'GET', '/items')).response.status, 500); }
+  finally { await new Promise(resolve => server.close(resolve)); await fs.rm(dir, { recursive: true, force: true }); }
+
+  const stages = [];
+  await withServer(async (base, committedFile) => {
+    const result = await request(base, 'POST', '/items', { id: 'one', title: 'One' });
+    assert.equal(result.response.status, 201);
+    assert.deepEqual(stages, ['beforeCommit', 'afterCommit']);
+    assert.equal(JSON.parse(await fs.readFile(committedFile, 'utf8')).items[0].id, 'one');
+  }, { onStage: stage => { stages.push(stage); } });
+});

