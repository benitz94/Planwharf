+'use strict';
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const os=require('node:os');
+const path=require('node:path');
+const {createScheduler}=require('./scheduler.cjs');
+
+function tempFile(){const dir=fs.mkdtempSync(path.join(os.tmpdir(),'scheduler-'));return {dir,file:path.join(dir,'nested','checkpoint.json')};}
+
+test('validates batches atomically and snapshots are sorted and detached',async()=>{
+ const {file}=tempFile(), s=createScheduler({file,concurrency:1,execute:async()=>({ok:true})});
+ await assert.rejects(s.enqueue([{id:'good'},{id:'bad',dependsOn:['missing']}]),/unknown dependency/);
+ assert.deepEqual(s.snapshot(),{version:1,jobs:[]});
+ await s.enqueue([{id:'zeta',payload:{n:1}},{id:'alpha'}]);
+ const snap=s.snapshot(); assert.deepEqual(snap.jobs.map(j=>j.id),['alpha','zeta']);
+ snap.jobs[0].payload.x=2; assert.equal(s.snapshot().jobs[0].payload.x,undefined);
+ assert.deepEqual(JSON.parse(fs.readFileSync(file,'utf8')).jobs.map(j=>j.id),['zeta','alpha']);
+});
+
+test('runs dependencies in order, respects concurrency, and persists results',async()=>{
+ const {file}=tempFile(); let active=0,max=0; const seen=[];
+ const s=createScheduler({file,concurrency:2,execute:async({id,attempt})=>{active++;max=Math.max(max,active);seen.push(`${id}:${attempt}`);await new Promise(r=>setTimeout(r,5));active--;return {id};}});
+ await s.enqueue([{id:'b',dependsOn:['a']},{id:'c'},{id:'a'}]);
+ const out=await Promise.all([s.run(),s.run()]);
+ assert.equal(max,2); assert.deepEqual(seen,['a:1','c:1','b:1']); assert.deepEqual(out[0],out[1]);
+ assert.deepEqual(s.snapshot().jobs.map(j=>[j.id,j.status,j.attempt]),[['a','completed',1],['b','completed',1],['c','completed',1]]);
+ const restarted=createScheduler({file,concurrency:1,execute:async()=>{throw Error('should not run')}}); await restarted.run();
+ assert.equal(restarted.snapshot().jobs.find(j=>j.id==='a').attempt,1);
+});
+
+test('fails jobs, transitively blocks descendants, and continues independent work',async()=>{
+ const {file}=tempFile(), stages=[];
+ const s=createScheduler({file,concurrency:2,onStage:async(stage,id)=>stages.push(`${stage}:${id}`),execute:async({id})=>{if(id==='fail')throw new Error('nope');return id;}});
+ await s.enqueue([{id:'child',dependsOn:['fail']},{id:'grand',dependsOn:['child']},{id:'fail'},{id:'independent'}]);
+ const result=await s.run();
+ assert.equal(result.jobs.find(j=>j.id==='fail').error,'nope');
+ assert.deepEqual(result.jobs.filter(j=>j.status==='blocked').map(j=>j.id),['child','grand']);
+ assert.equal(result.jobs.find(j=>j.id==='independent').status,'completed');
+ assert.ok(stages.includes('claimed:fail')&&stages.includes('completed:independent'));
+});
+
+test('recovers running jobs as pending and increments attempt',async()=>{
+ const {file}=tempFile(); fs.mkdirSync(path.dirname(file),{recursive:true});
+ fs.writeFileSync(file,JSON.stringify({version:1,jobs:[{id:'crash',dependsOn:[],payload:null,status:'running',attempt:1}]}));
+ const calls=[]; const s=createScheduler({file,concurrency:1,execute:async x=>{calls.push(x);return 'ok';}});
+ assert.equal(s.snapshot().jobs[0].status,'pending'); await s.run();
+ assert.deepEqual(calls,[{id:'crash',payload:null,attempt:2}]);
+ assert.equal(JSON.parse(fs.readFileSync(file,'utf8')).jobs[0].status,'completed');
+});

