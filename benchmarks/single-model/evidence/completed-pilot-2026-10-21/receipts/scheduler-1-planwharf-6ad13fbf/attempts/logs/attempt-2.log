'use strict';
const fs=require('node:fs'),path=require('node:path');
const ID=/^[a-z][a-z0-9-]{0,31}$/, OK=new Set(['pending','running','completed','failed','blocked']);
const copy=x=>JSON.parse(JSON.stringify(x)), estr=e=>e instanceof Error?e.message:String(e);
function createScheduler(o){
 if(!o||typeof o!=='object')throw new TypeError('options are required'); const {file,concurrency,execute,onStage}=o;
 if(typeof file!=='string'||!file)throw new TypeError('file must be a non-empty string');
 if(!Number.isInteger(concurrency)||concurrency<1||concurrency>8)throw new TypeError('concurrency must be an integer from 1 to 8');
 if(typeof execute!=='function')throw new TypeError('execute must be a function'); if(onStage!==undefined&&typeof onStage!=='function')throw new TypeError('onStage must be a function');
 let state,recovered=false; try{if(!fs.existsSync(file))state={version:1,jobs:[]};else{state=JSON.parse(fs.readFileSync(file,'utf8'));validate(state);for(const j of state.jobs)if(j.status==='running'){j.status='pending';recovered=true;}}}catch(e){throw new Error('invalid checkpoint: '+estr(e));}
 let enq=Promise.resolve(),drainPromise=null;const active=new Set();
 function write(v){const text=JSON.stringify(v),dir=path.dirname(file),tmp=`${file}.tmp-${process.pid}-${Date.now()}-${Math.random().toString(16).slice(2)}`;fs.mkdirSync(dir,{recursive:true});try{fs.writeFileSync(tmp,text);fs.renameSync(tmp,file);}catch(e){try{fs.unlinkSync(tmp)}catch(_){}throw e;}}
 function save(){write(state);recovered=false;}
 function enqueue(jobs){const op=enq.then(async()=>{if(!Array.isArray(jobs))throw new TypeError('jobs must be an array');const c=copy(state),ids=new Set(c.jobs.map(j=>j.id)),add=[];for(const x of jobs){if(!x||typeof x!=='object'||Array.isArray(x))throw new TypeError('each job must be an object');for(const k of Object.keys(x))if(!['id','dependsOn','payload'].includes(k))throw new TypeError('unknown job field: '+k);const id=x.id;if(typeof id!=='string'||!ID.test(id))throw new TypeError('invalid job id: '+id);if(ids.has(id))throw new Error('duplicate or existing job id: '+id);ids.add(id);const d=x.dependsOn===undefined?[]:x.dependsOn;if(!Array.isArray(d)||d.some(y=>typeof y!=='string'))throw new TypeError('invalid dependencies for '+id);if(new Set(d).size!==d.length||d.includes(id))throw new Error('repeated or self dependency for '+id);add.push({id,dependsOn:d.slice(),payload:x.payload===undefined?null:x.payload,status:'pending',attempt:0});}const all=new Set(c.jobs.map(j=>j.id).concat(add.map(j=>j.id)));for(const j of add)for(const d of j.dependsOn)if(!all.has(d))throw new Error('unknown dependency: '+d);c.jobs.push(...add);acyclic(c.jobs);JSON.stringify(c);write(c);state=c;});enq=op.catch(()=>{});return op;}
 function ready(){return state.jobs.filter(j=>j.status==='pending'&&j.dependsOn.every(d=>state.jobs.find(x=>x.id===d)?.status==='completed')).sort((a,b)=>a.id.localeCompare(b.id))[0];}
 async function claim(j){j.status='running';j.attempt++;save();if(onStage)await onStage('claimed',j.id);}
 async function block(id){const bs=state.jobs.filter(j=>j.status==='pending'&&j.dependsOn.some(d=>d===id||state.jobs.find(x=>x.id===d)?.status==='failed'||state.jobs.find(x=>x.id===d)?.status==='blocked'));for(const j of bs){j.status='blocked';save();}for(const j of bs)await block(j.id);}
 async function work(j){try{const r=await execute({id:j.id,payload:copy(j.payload),attempt:j.attempt});JSON.stringify(r);j.result=copy(r);j.status='completed';delete j.error;save();if(onStage)await onStage('completed',j.id);}catch(e){j.status='failed';j.error=estr(e);delete j.result;save();await block(j.id);}}
 async function drain(){if(recovered)save();for(;;){while(active.size<concurrency){const j=ready();if(!j)break;await claim(j);let p;p=work(j).finally(()=>active.delete(p));active.add(p);}if(active.size){await Promise.race(active);continue;}if(!state.jobs.some(j=>j.status==='pending'))break;for(const j of state.jobs.filter(j=>j.status==='pending')){j.status='blocked';save();}break;}return snapshot();}
 function run(){if(!drainPromise)drainPromise=drain().finally(()=>{drainPromise=null});return drainPromise;}function snapshot(){return copy(state);}return{enqueue,run,snapshot};
}
function validate(v){if(!v||v.version!==1||!Array.isArray(v.jobs))throw new Error('checkpoint must contain version 1 and jobs');const ids=new Set();for(const j of v.jobs){if(!j||typeof j.id!=='string'||!ID.test(j.id)||ids.has(j.id))throw new Error('invalid or duplicate checkpoint id');ids.add(j.id);if(!Array.isArray(j.dependsOn)||j.dependsOn.some(d=>typeof d!=='string')||new Set(j.dependsOn).size!==j.dependsOn.length||j.dependsOn.includes(j.id))throw new Error('invalid checkpoint dependencies');if(!OK.has(j.status)||!Number.isInteger(j.attempt)||j.attempt<0)throw new Error('invalid checkpoint job');for(const k of Object.keys(j))if(!['id','dependsOn','payload','status','attempt','result','error'].includes(k))throw new Error('unknown checkpoint field');}for(const j of v.jobs)for(const d of j.dependsOn)if(!ids.has(d))throw new Error('unknown checkpoint dependency');acyclic(v.jobs);}
